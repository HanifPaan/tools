#!/bin/bash

BUILD_FILE="/usr/local/lsws/BUILD"

# Read the content of the BUILD file, trimming whitespace
BUILD_VAL=$(cat "$BUILD_FILE" 2>/dev/null | tr -d '[:space:]')

# Check if value is NOT equal to 2 (handles missing files or non-2 values)
if [ "$BUILD_VAL" != "2" ]; then
    echo "BUILD value is '$BUILD_VAL' (not 2). Running update script..."
    /usr/local/lsws/admin/misc/lsup.sh
    echo "Curent Build"    
    cat /usr/local/lsws/BUILD
else
    echo "BUILD value is 2. No update required."
fi
