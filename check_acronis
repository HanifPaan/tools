cat > /root/check_acronis_userdata.sh <<'SCRIPT_END'
#!/bin/bash
# Checks cPanel's /etc/userdatadomains for any domain whose path points
# into /mnt/acronis (stale Acronis mounts picked up by cPanel).
# Sends an email alert if any are found.

ALERT_EMAIL="hanif@serverfreak.com, hazreen@serverfreak.com, sean@serverfreak.com, Azlan@serverfreak.com"   # <-- change these
FILE="/etc/userdatadomains"
PATTERN="/mnt/acronis"
HOST=$(hostname -f)
LOG="/var/log/check_acronis_userdata.log"

if [ ! -r "$FILE" ]; then
    echo "$(date '+%F %T') ERROR: cannot read $FILE" >> "$LOG"
    exit 1
fi

MATCHES=$(grep -i "$PATTERN" "$FILE")

if [ -n "$MATCHES" ]; then
    COUNT=$(echo "$MATCHES" | wc -l)
    echo "$(date '+%F %T') FOUND $COUNT match(es), sending alert to $ALERT_EMAIL" >> "$LOG"

    /usr/sbin/sendmail -t <<EOF
To: $ALERT_EMAIL
From: root@$HOST
Subject: [ALERT] $HOST - $COUNT domain(s) pointing to $PATTERN

Server: $HOST
Time:   $(date '+%F %T %Z')
File:   $FILE

The following entries contain "$PATTERN":

$MATCHES
EOF
else
    echo "$(date '+%F %T') OK, no matches" >> "$LOG"
fi
SCRIPT_END

chmod +x /root/check_acronis_userdata.sh

( crontab -l 2>/dev/null | grep -qF '/root/check_acronis_userdata.sh' ) || \
( crontab -l 2>/dev/null; echo '0 */6 * * * /root/check_acronis_userdata.sh >/dev/null 2>&1' ) | crontab -

echo "--- installed ---"
ls -l /root/check_acronis_userdata.sh
crontab -l | grep check_acronis
