#!/bin/bash
#
# cpsetup - full cPanel server setup (SF), single script
#
# Usage:
#   set +o history; yum update -y; bash <(curl -fsSL https://raw.githubusercontent.com/HanifPaan/tools/refs/heads/main/cpsetup)

CORE_URL_BASE="https://sf.sekai.my/cpsetup"
SF_REPO_RPM="https://repo.sfdns.net/serverfreak-release-1.0-1.noarch.rpm"
SF_REPO_CHECK="https://repo.sfdns.net/repodata/repomd.xml"
SF_SUBNETS="103.27.72.0/22 220.158.200.0/22 185.93.164.0/22 103.10.78.0/24 103.100.152.0/22"
PROFILE_DIR="/root/cpanel_profile"
PROFILE="${PROFILE_DIR}/cpanel.config"
TMUX_SESSION="cpanel"

fail() {
    echo
    echo " -- Prerequisite check failed -- "
    for line in "$@"; do echo "$line"; done
    echo
    exit 1
}

# ======================================================================
# 0. Not already installed / running
# ======================================================================
if [[ -x /usr/local/cpanel/cpanel ]]; then
    fail "cPanel is already installed on this server (/usr/local/cpanel exists)"
fi
if command -v tmux >/dev/null && tmux has-session -t "$TMUX_SESSION" 2>/dev/null; then
    fail "tmux session '$TMUX_SESSION' already exists - installer may be running" \
         "Check with: tmux attach -t $TMUX_SESSION"
fi

# ======================================================================
# 1. OS check
# ======================================================================
OS_MAJOR=""
[[ -r /etc/os-release ]] && OS_MAJOR=$(. /etc/os-release; echo "${VERSION_ID%%.*}")
[[ -z "$OS_MAJOR" ]] && OS_MAJOR=$(grep -ohE 'release [0-9]+' /etc/*release 2>/dev/null | head -n1 | grep -oE '[0-9]+')

case "$OS_MAJOR" in
    8)  rpm --import https://repo.almalinux.org/almalinux/RPM-GPG-KEY-AlmaLinux
        CORE_SCRIPT="cpsetup_core_rh8.sh" ;;
    9)  CORE_SCRIPT="cpsetup_core_rh9.sh" ;;
    10) echo "cpsetup on AL10 still experimental"
        CORE_SCRIPT="cpsetup_core_rh9.sh" ;;
    *)  fail "OS check failed (detected: '${OS_MAJOR:-unknown}', need 8, 9 or 10)" ;;
esac

# ======================================================================
# 2. Hostname check
# ======================================================================
HOSTNAME_FQDN=$(hostname)
if [[ "$HOSTNAME_FQDN" == *localhost* || "$HOSTNAME_FQDN" != *.*.* ]]; then
    fail "Hostname not set to a FQDN: $HOSTNAME_FQDN"
fi

# ======================================================================
# 3. cPanel license check
# ======================================================================
echo -n "Checking for cPanel license . . . "
cpip=$(curl -fsSL https://myip.cpanel.net)
[[ -z "$cpip" ]] && fail "Unable to get public IP from myip.cpanel.net"
cplicense=$(curl -fsS "https://verify.cpanel.net/app/verify?ip=${cpip}")
isHypervisor=$(lscpu | grep "Hypervisor vendor")
VERIFY_URL="https://verify.cpanel.net/app/verify?ip=${cpip}"
pauseInstaller=1

if grep -qE "removed on|expired on" <<< "$cplicense"; then
    fail "cPanel license for ${cpip} has expired" "$VERIFY_URL"
elif grep -q "Not licensed" <<< "$cplicense"; then
    fail "cPanel license for ${cpip} not found" "$VERIFY_URL"
elif [[ -n $isHypervisor ]] && grep -qi "metal" <<< "$cplicense"; then
    fail "cPanel license for ${cpip} is for bare metal" "but this server runs inside a hypervisor" "$VERIFY_URL"
elif [[ -z $isHypervisor ]] && grep -qi "cloud" <<< "$cplicense"; then
    fail "cPanel license for ${cpip} is for cloud server" "but this server is not inside a hypervisor" "$VERIFY_URL"
elif [[ -n $isHypervisor ]] && grep -qi "cloud" <<< "$cplicense"; then
    echo; echo "Hypervisor detected & cPanel license is for cloud server"
    pauseInstaller=0
elif [[ -z $isHypervisor ]] && grep -qiE "metal|cPanel Autoscale \(Internal\)" <<< "$cplicense"; then
    echo; echo "No hypervisor detected & cPanel license is for bare metal server"
    pauseInstaller=0
fi

if [[ $pauseInstaller == 1 ]]; then
    echo
    echo "Unable to determine suitability of cPanel license type for this server."
    echo "Please check manually: $VERIFY_URL"
    read -r -p "Do you want to continue? [y/N] " -n 1
    echo
    [[ $REPLY =~ ^[Yy]$ ]] || exit 1
fi
echo "OK"
echo

# ======================================================================
# 4. MySQL / MariaDB version (writes exactly one valid line, never blank)
# ======================================================================
case "$OS_MAJOR" in
    10) DB_SUPPORTED=(8.4 10.11 11.4 11.8) ;;
    *)  DB_SUPPORTED=(8.0 8.4 10.5 10.6 10.11 11.4 11.8) ;;
esac

db_supported() { local v; for v in "${DB_SUPPORTED[@]}"; do [[ "$v" == "$1" ]] && return 0; done; return 1; }

db_write() {
    mkdir -p "$PROFILE_DIR"
    [[ -f "$PROFILE" ]] && sed -i '/^[[:space:]]*mysql-version[[:space:]]*=/d' "$PROFILE"
    [[ -s "$PROFILE" && -n "$(tail -c1 "$PROFILE")" ]] && echo >> "$PROFILE"
    echo "mysql-version=$1" >> "$PROFILE"
    echo "[mysql] mysql-version=$1 set in $PROFILE"
}

select_db_version() {
    local existing="" count=0 try v

    if [[ -f "$PROFILE" ]]; then
        existing=$(grep -E '^[[:space:]]*mysql-version[[:space:]]*=' "$PROFILE" \
                   | sed -E 's/^[^=]*=[[:space:]]*//; s/[[:space:]]*$//' | grep -v '^$' | tail -n1)
        count=$(grep -cE '^[[:space:]]*mysql-version[[:space:]]*=' "$PROFILE")
    fi

    # valid version already in profile
    if [[ -n "$existing" ]] && db_supported "$existing"; then
        if (( count > 1 )); then db_write "$existing"
        else echo "[mysql] Using existing mysql-version=$existing"; fi
        return
    fi
    if (( count > 0 )); then
        echo "[mysql] Removing invalid/blank mysql-version line(s) from $PROFILE"
        sed -i '/^[[:space:]]*mysql-version[[:space:]]*=/d' "$PROFILE"
    fi

    # ask
    echo "Select MySQL / MariaDB version or press Enter to install WHM default"
    echo "https://docs.cpanel.net/knowledge-base/general-systems-administration/supported-mysql-mariadb-versions/"
    echo "Available options (OS $OS_MAJOR): ${DB_SUPPORTED[*]}"
    for (( try = 1; try <= 3; try++ )); do
        read -r -p "Version: " v
        v="${v//[[:space:]]/}"
        if [[ -z "$v" ]]; then echo "[mysql] Using WHM default"; return; fi
        if db_supported "$v"; then db_write "$v"; return; fi
        echo "'$v' is not valid. Choose one of: ${DB_SUPPORTED[*]}"
    done
    echo "[mysql] Too many invalid attempts, using WHM default"
}

select_db_version
echo

# ======================================================================
# 5. Helpers: subnet check
# ======================================================================
ip2int() { local IFS=. a b c d; read -r a b c d <<< "$1"; echo $(( (a<<24) | (b<<16) | (c<<8) | d )); }

in_sf_network() {
    local subnet net mask ip netmask
    ip=$(ip2int "$cpip")
    for subnet in $SF_SUBNETS; do
        net=$(ip2int "${subnet%/*}"); mask="${subnet#*/}"
        netmask=$(( (0xFFFFFFFF << (32 - mask)) & 0xFFFFFFFF ))
        (( (ip & netmask) == (net & netmask) )) && return 0
    done
    return 1
}

# ======================================================================
# 6. SF repo + cPanel mirror
# ======================================================================
echo -n "Checking connectivity to SF repo . . . "
if ! curl -fsSI "$SF_REPO_CHECK" >/dev/null; then
    fail "${cpip} maybe not whitelisted by SF repo"
fi
echo "OK"

rpm -q serverfreak-release >/dev/null || rpm -ivh "$SF_REPO_RPM"

if [[ ! -f /etc/cpsources.conf ]] || ! grep -q HTTPUPDATE /etc/cpsources.conf; then
    if in_sf_network; then
        echo "Adding SF's cPanel mirror"
        dnf install -y sf-cpsources-conf
    fi
fi

# ======================================================================
# 7. Packages
# ======================================================================
if lscpu | grep -i 'Hypervisor vendor' | grep -q 'KVM'; then
    echo "Installing QEMU Agent"
    dnf install -y qemu-guest-agent
fi

dnf install -y nano rsync bash-completion tmux

for bin in tmux rsync; do
    command -v "$bin" >/dev/null || fail "$bin failed to install - fix dnf and re-run"
done

# temp fix for expired mysql gpg key
rpm --import https://repo.mysql.com/RPM-GPG-KEY-mysql-2022

# ======================================================================
# 8. Start cPanel install in tmux
# ======================================================================
echo
tmux new-session -d -s "$TMUX_SESSION" || fail "Could not start tmux session"
tmux send-keys -t "$TMUX_SESSION" "set +o history" C-m
tmux send-keys -t "$TMUX_SESSION" "bash <(curl -fsSL ${CORE_URL_BASE}/${CORE_SCRIPT})" C-m
echo "cPanel install started inside tmux ($CORE_SCRIPT). Watch with: tmux attach -t $TMUX_SESSION"
echo

# ======================================================================
# 9. rDNS (SF network only). Key is pulled from sf.sekai.my at runtime,
#    so it never lives in this git repo.
# ======================================================================
configure_rdns() {
    local keyfile
    keyfile=$(mktemp /root/.ncsshauthkey.XXXXXX) || return 1
    chmod 600 "$keyfile"
    curl -fsSL "${CORE_URL_BASE}/cpsetup_auto.sh" \
        | sed -n '/BEGIN OPENSSH PRIVATE KEY/,/END OPENSSH PRIVATE KEY/p' \
        | sed -E 's/^.*echo "//; s/" > .*$//' > "$keyfile"

    if ! grep -q "END OPENSSH PRIVATE KEY" "$keyfile"; then
        echo "rDNS skipped: could not fetch key"
        rm -f "$keyfile"; return 1
    fi

    echo "Configuring rDNS for ${cpip} to ${HOSTNAME_FQDN}"
    ssh pdns1.serverfreak.biz -p55000 -o "IdentitiesOnly yes" -o "StrictHostKeyChecking no" \
        -o UserKnownHostsFile=/dev/null -i "$keyfile" "$HOSTNAME_FQDN"
    rm -f "$keyfile"
    echo "rDNS configured"
}

in_sf_network && configure_rdns

# ======================================================================
# 10. thebastion client ssh key
# ======================================================================
bash <(curl -fsSL https://sf.sekai.my/ssh_client.sh)

echo
echo "Done. cPanel install is running in tmux: tmux attach -t $TMUX_SESSION"
