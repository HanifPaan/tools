#!/bin/bash
#
# cpsetup_mysql.sh - choose the MySQL / MariaDB version for a new cPanel install
#
# Writes exactly one valid "mysql-version=X" line to /root/cpanel_profile/cpanel.config
# (or leaves the file alone so WHM uses its default). Safe to run any number of times.
#
# Usage:
#   bash <(curl -s https://sf.sekai.my/cpsetup/cpsetup_mysql.sh)          # interactive
#   DBVERSION=8.4 bash <(curl -s https://sf.sekai.my/cpsetup/cpsetup_mysql.sh)  # non-interactive
#   bash cpsetup_mysql.sh 10.11                                            # non-interactive
#
# Behaviour:
#   - Profile already has a valid version  -> keep it, remove blanks/duplicates
#   - Profile has an invalid/blank version -> remove it, then ask
#   - No version given / Enter pressed     -> write nothing, WHM default is used
#   - Never writes "mysql-version=" with an empty value
#   - Always exits 0 so the parent cpsetup script continues

PROFILE_DIR="${CPANEL_PROFILE_DIR:-/root/cpanel_profile}"
PROFILE="${PROFILE_DIR}/cpanel.config"
DOCS_URL="https://docs.cpanel.net/knowledge-base/general-systems-administration/supported-mysql-mariadb-versions/"
MAX_TRIES=3

# ---------- OS detection ----------
os_major() {
    local v=""
    if [[ -r /etc/os-release ]]; then
        v=$(. /etc/os-release; echo "${VERSION_ID%%.*}")
    fi
    if [[ -z "$v" ]]; then
        v=$(grep -oE 'release [0-9]+' /etc/*release 2>/dev/null | head -n1 | grep -oE '[0-9]+')
    fi
    echo "$v"
}

OS_MAJOR="${OS_MAJOR_OVERRIDE:-$(os_major)}"

case "$OS_MAJOR" in
    10) SUPPORTED=(8.4 10.11 11.4 11.8) ;;
    8|9) SUPPORTED=(8.0 8.4 10.5 10.6 10.11 11.4 11.8) ;;
    *)
        echo "[mysql] Unknown OS version '${OS_MAJOR}', skipping DB version selection (WHM default will be used)"
        exit 0
        ;;
esac

is_supported() {
    local want="$1" v
    for v in "${SUPPORTED[@]}"; do
        [[ "$v" == "$want" ]] && return 0
    done
    return 1
}

# Remove every mysql-version line from the profile (blank, invalid or duplicate)
strip_mysql_lines() {
    [[ -f "$PROFILE" ]] && sed -i '/^[[:space:]]*mysql-version[[:space:]]*=/d' "$PROFILE"
}

write_version() {
    local ver="$1"
    mkdir -p "$PROFILE_DIR"
    strip_mysql_lines
    # make sure we start on a new line if the file doesn't end with one
    if [[ -s "$PROFILE" && -n "$(tail -c1 "$PROFILE")" ]]; then
        echo >> "$PROFILE"
    fi
    echo "mysql-version=${ver}" >> "$PROFILE"
    echo "[mysql] Set mysql-version=${ver} in ${PROFILE}"
}

# ---------- 1. Existing profile ----------
if [[ -f "$PROFILE" ]]; then
    # last non-empty value wins, same as the cPanel installer
    existing=$(grep -E '^[[:space:]]*mysql-version[[:space:]]*=' "$PROFILE" \
               | sed -E 's/^[^=]*=[[:space:]]*//; s/[[:space:]]*$//' \
               | grep -v '^$' | tail -n1)
    count=$(grep -cE '^[[:space:]]*mysql-version[[:space:]]*=' "$PROFILE")

    if [[ -n "$existing" ]] && is_supported "$existing"; then
        if (( count > 1 )); then
            write_version "$existing"     # clean up blanks/duplicates
        else
            echo "[mysql] Using existing mysql-version=${existing} from ${PROFILE}"
        fi
        exit 0
    fi

    if (( count > 0 )); then
        echo "[mysql] Removing invalid/blank mysql-version line(s) from ${PROFILE}"
        strip_mysql_lines
    fi
fi

# ---------- 2. Non-interactive (argument or DBVERSION env) ----------
choice="${1:-${DBVERSION:-}}"
if [[ -n "$choice" ]]; then
    if is_supported "$choice"; then
        write_version "$choice"
    else
        echo "[mysql] '${choice}' is not supported on OS ${OS_MAJOR} (options: ${SUPPORTED[*]})"
        echo "[mysql] Nothing written, WHM default will be used"
    fi
    exit 0
fi

# ---------- 3. Interactive ----------
if [[ ! -t 0 ]]; then
    echo "[mysql] No terminal to ask on, WHM default will be used"
    exit 0
fi

echo
echo "Select MySQL / MariaDB version or press Enter to install WHM default"
echo "Be sure the version is supported by the OS:"
echo "${DOCS_URL}"
echo
echo "Available options (OS ${OS_MAJOR}): ${SUPPORTED[*]}"

for (( try = 1; try <= MAX_TRIES; try++ )); do
    read -r -p "Version: " dbversion
    dbversion="${dbversion//[[:space:]]/}"

    if [[ -z "$dbversion" ]]; then
        echo "[mysql] No version chosen, WHM default will be used"
        exit 0
    fi

    if is_supported "$dbversion"; then
        write_version "$dbversion"
        exit 0
    fi

    echo "'${dbversion}' is not valid. Choose one of: ${SUPPORTED[*]} (or Enter for default)"
done

echo "[mysql] Too many invalid attempts, WHM default will be used"
exit 0
