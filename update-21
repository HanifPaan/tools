#!/bin/bash
MIN_GB=3   # minimum free space (GB) required on /

# Run yum update but answer "n" so nothing is installed (just shows the list)
OUTPUT=$(echo "n" | yum update 2>&1)
echo "$OUTPUT"
echo

if echo "$OUTPUT" | grep -q "Transaction Summary"; then
    echo "RESULT: CAN UPDATE (updates available)"
    echo
    echo "Checking storage..."
    df -h /
    echo

    AVAIL_GB=$(df -BG --output=avail / | tail -1 | tr -dc '0-9')

    if [ "$AVAIL_GB" -gt "$MIN_GB" ]; then
        echo "STORAGE ENOUGH (${AVAIL_GB}G free, need more than ${MIN_GB}G) - can update"
    else
        echo "STORAGE NOT ENOUGH (${AVAIL_GB}G free, need more than ${MIN_GB}G) - cannot update"
    fi
else
    echo "RESULT: CANNOT UPDATE (no updates available / nothing to do)"
fi

exit 0
